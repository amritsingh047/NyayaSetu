# ============================================================
# LexAI Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- App ----
APP_ENV=development
APP_SECRET_KEY=change-me-in-production-at-least-32-chars
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://lexai:lexai_dev@localhost:5432/lexai
REDIS_URL=redis://localhost:6379/0

# ---- Google Cloud / Vertex AI ----
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_REGION=us-central1
GCS_BUCKET_NAME=lexai-documents-dev
VERTEX_AI_EMBEDDING_MODEL=text-embedding-004
VERTEX_AI_LLM_MODEL=gemini-1.5-pro-002

# ---- Firebase Auth ----
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_SERVICE_ACCOUNT_JSON=./firebase-service-account.json

# ---- Ollama (Local Mode) ----
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=mistral:7b

# ---- Langfuse (Observability) ----
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_HOST=https://cloud.langfuse.com

# ---- Processing ----
MAX_UPLOAD_SIZE_MB=50
CHUNK_SIZE_TOKENS=500
CHUNK_OVERLAP_TOKENS=50
TOP_K_CHUNKS=8
DOCUMENT_TTL_DAYS=7

# ---- Rate Limiting ----
RATE_LIMIT_PER_MINUTE=10

# ---- Feature Flags ----
ENABLE_LOCAL_MODE=true
ENABLE_CLOUD_MODE=true
REQUIRE_AUTH_FOR_UPLOAD=false
